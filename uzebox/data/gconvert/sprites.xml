<?xml version="1.0" encoding="utf-8"?>
<gconvert>
    <!-- 
        Uzebox Mode 3 Sprite Converter
        Generates sprites.inc for use with SetSpritesTileTable()
        
        Sprite size: 16x16 pixels (2x2 tiles, 4 tiles per sprite)
        Color depth: 256 colors (palette-based)
    -->
    
    <output
        filename="sprites.inc"
        format="c"
        type="sprites"
        palette="../assets/palette.bmp"
    />
    
    <!-- 
        Character sprites (Bubble & Bobble)
        BubbleCharacter.png: 96x64 pixels = 6 sprites (2x3 grid of 16x16 sprites)
        BobbleCharacter.png: 96x64 pixels = 6 sprites (2x3 grid of 16x16 sprites)
    -->
    
    <image
        filename="../assets/BubbleCharacter.png"
        tile_width="8"
        tile_height="8"
        sprite_width="2"
        sprite_height="2"
        tiles_x="6"
        tiles_y="4"
        offset_x="0"
        offset_y="0"
    />
    
    <image
        filename="../assets/BobbleCharacter.png"
        tile_width="8"
        tile_height="8"
        sprite_width="2"
        sprite_height="2"
        tiles_x="6"
        tiles_y="4"
        offset_x="0"
        offset_y="0"
    />
    
</gconvert>