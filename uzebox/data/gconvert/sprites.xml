<?xml version="1.0" encoding="utf-8"?>
<gconvert>
    <!-- 
        Uzebox Mode 3 Sprite Converter
        Generates sprites.inc for use with SetSpritesTileTable()
        
        Sprite size: 16x16 pixels (2x2 tiles, 4 tiles per sprite)
        Color depth: 256 colors (palette-based)
    -->
    
    <output
        filename="sprites.inc"
        format="c"
        type="sprites"
        palette="palette.bmp"
    />
    
    <!-- 
        Source sprite sheet
        Organizes sprites in a grid layout
    -->
    
    <image
        filename="spritesheet.png"
        tile_width="8"
        tile_height="8"
        offset_x="0"
        offset_y="0"
        sprite_width="2"
        sprite_height="2"
    />
    
</gconvert>