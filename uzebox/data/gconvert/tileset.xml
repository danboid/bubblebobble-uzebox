<?xml version="1.0" encoding="utf-8"?>
<gconvert>
    <!-- 
        Uzebox Mode 3 Tileset Converter
        Generates tileset.inc for use with SetTileTable()
        
        Tile size: 8x8 pixels
        Source: Assets/LevelTiles.png (40x200 = 5x25 tiles)
    -->
    
    <output
        filename="tileset.inc"
        format="c"
        type="tileset"
        palette="../assets/palette.bmp"
    />
    
    <!-- 
        Level tiles (background)
        LevelTiles.png: 40x200 pixels = 5 columns x 25 rows of 8x8 tiles
    -->
    
    <image
        filename="../assets/LevelTiles.png"
        tile_width="8"
        tile_height="8"
        tiles_x="5"
        tiles_y="25"
        offset_x="0"
        offset_y="0"
    />
    
</gconvert>